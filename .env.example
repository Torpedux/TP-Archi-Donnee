# Copier en .env pour changer une valeur. Les valeurs ci-dessous sont les défauts d'importer.py.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=esport
PG_DSN=postgresql://postgres:postgres@localhost:5432/esport
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=motdepasse
PORT_POSTGRES=5432
PORT_NEO4J=7687
PORT_NEO4J_WEB=7474
PORT_APP=3000
# Application : secret des sessions et admin créé au premier lancement (à changer hors démo)
AUTH_SECRET=bracket-demo-secret-a-changer-0123456789
ADMIN_EMAIL=admin@bracket.test
ADMIN_PASSWORD=admin-bracket
